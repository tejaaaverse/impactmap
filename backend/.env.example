# Backend configuration
APP_NAME=IMPACTMAP
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./impactmap.db
HOST=0.0.0.0
PORT=8000

# Optional: restrict repositories that may be scanned (JSON list)
# ALLOWED_SCAN_ROOTS=["/path/to/repositories"]

# Optional: CORS allowed origins (JSON list)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Analysis limits
ANALYSIS_MAX_DEPTH=8
ANALYSIS_MAX_NODES=2500

# Test execution
TEST_EXECUTION_TIMEOUT_SECONDS=600
MAX_TEST_OUTPUT_BYTES=200000

# Copilot / OpenAI-compatible model (optional; leave key empty for local evidence mode)
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_CONTEXT_CHARS=24000
COPILOT_RETRIEVAL_TOP_K=6
COPILOT_MAX_FILE_BYTES=600000
COPILOT_MAX_HISTORY_MESSAGES=12
