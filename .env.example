# =============================================================================
# IMPACTMAP — Environment Configuration Template
# =============================================================================
# Copy this file to backend/.env or export these variables in your environment.
# Never commit real credentials or secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Settings
# -----------------------------------------------------------------------------
APP_NAME=IMPACTMAP
DEBUG=false
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite+aiosqlite:///./impactmap.db

# Optional: Restrict repository paths that can be scanned (JSON array of absolute paths)
# ALLOWED_SCAN_ROOTS=["/Users/username/projects"]

# Optional: CORS allowed origins (JSON array)
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Analysis limits
ANALYSIS_MAX_DEPTH=8
ANALYSIS_MAX_NODES=2500

# Test execution limits
TEST_EXECUTION_TIMEOUT_SECONDS=600
MAX_TEST_OUTPUT_BYTES=200000

# Copilot / LLM Configuration (Optional)
# If LLM_API_KEY is left empty, Copilot runs in deterministic local evidence mode
# using AST graphs, Git diffs, and static analysis findings.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_CONTEXT_CHARS=24000
COPILOT_RETRIEVAL_TOP_K=6
COPILOT_MAX_FILE_BYTES=600000
COPILOT_MAX_HISTORY_MESSAGES=12

# -----------------------------------------------------------------------------
# Frontend Settings (frontend/.env or Vite environment)
# -----------------------------------------------------------------------------
# Leave empty to use the Vite dev server reverse proxy (default)
# VITE_API_BASE_URL=
# VITE_PROXY_TARGET=http://localhost:8000
